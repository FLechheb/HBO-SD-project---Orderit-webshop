<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.effect.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.paint.*?>
<?import javafx.scene.text.*?>


<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.example.orderit.MainViewController">

    <top>
        <HBox spacing="10" alignment="CENTER_LEFT">
            <padding>
                <Insets top="10" right="10" bottom="10" left="10"/>
            </padding>

            <Label text="Zoek:"/>

            <TextField fx:id="searchField"
                       promptText="Zoek fruit..."
                       onKeyReleased="#filterFruit"/>
        </HBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true">
            <content>
                <GridPane fx:id="fruitGrid"
                          hgap="50" vgap="40"
                          BorderPane.alignment="CENTER">
                    <padding>
                        <Insets top="30" right="20" bottom="20" left="20"/>
                    </padding>
                    </GridPane>
            </content>
        </ScrollPane>
    </center>



    <right>

        <VBox alignment="TOP_RIGHT" prefHeight="900.0" prefWidth="400.0">
            <padding>
                <Insets bottom="30.0" left="30.0" right="20.0" top="20.0" />
            </padding>

            <children>
            <HBox alignment="TOP_CENTER" prefHeight="100.0" prefWidth="300.0" spacing="20">
                <ImageView fitHeight="80.0" fitWidth="200.0">
                    <image>
                        <Image url="@../Images/logo.png" />
                    </image>
                </ImageView>
                <Region prefHeight="50" />
            </HBox>

            <Region prefHeight="50" />

            <Label contentDisplay="CENTER" lineSpacing="30" prefHeight="50" prefWidth="340" text="Winkelmandje"
                   style="-fx-font-size: 24px; -fx-font-weight: bold;" />


                <VBox spacing="30">

                    <TableView fx:id="winkelmandTable" prefWidth="300" prefHeight="600">

                        <columns>
                            <TableColumn fx:id="productColumn" text="Product"/>
                            <TableColumn fx:id="aantalColumn" text="Aantal"/>
                            <TableColumn fx:id="prijsColumn" text="Prijs"/>

                            <TableColumn fx:id="plusColumn" text="+" prefWidth="40"/>
                            <TableColumn fx:id="minColumn" text="-" prefWidth="40"/>
                        </columns>

                    </TableView>


                </VBox>
                <Region prefHeight="20" />

                <Label fx:id="totaalLabel" alignment="BOTTOM_RIGHT" lineSpacing="30" text="Totaal: €0.00" >
                <font>
                    <Font name="System Bold" size="22.0" />
                </font></Label>

                <Region prefHeight="20" />

                <Button onAction="#clearMand" text="Leeg winkelmandje" />
            </children></VBox>
    </right>

</BorderPane>
