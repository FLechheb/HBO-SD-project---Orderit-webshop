<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>


<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.example.orderit.MainViewController">

    <top>
        <HBox spacing="10" alignment="CENTER_LEFT">
            <padding>
                <Insets top="10" right="10" bottom="10" left="10"/>
            </padding>

            <Label text="Zoek:"/>

            <TextField fx:id="searchField"
                       promptText="Zoek fruit..."
                       onKeyReleased="#filterFruit"/>
        </HBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true">
            <content>
                <GridPane fx:id="fruitGrid"
                          hgap="20" vgap="20"
                          BorderPane.alignment="CENTER">
                    <padding>
                        <Insets top="20" right="20" bottom="20" left="20"/>
                    </padding>
                    </GridPane>
            </content>
        </ScrollPane>
    </center>



    <right>
        <BorderPane fx:id="cartPane"
                    prefWidth="350"
                    style="-fx-border-color: gray; -fx-border-width: 1;">
            <padding>
                <Insets top="20" right="20" bottom="20" left="20"/>
            </padding>

            <top>
                <Label text="Winkelmandje:" fx:id="cartTitle"/>
            </top>

            <center>
                <ListView fx:id="cartListView"
                          prefHeight="50"
                          prefWidth="350"/>
            </center>
        </BorderPane>
    </right>

</BorderPane>
